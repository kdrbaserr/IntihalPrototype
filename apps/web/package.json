{
  "name": "intihal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src e2e playwright.config.ts next.config.ts vitest.config.ts vitest.setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run-playwright.mjs test",
    "test:e2e:live": "node e2e/run-playwright.mjs test --config e2e/live.config.ts",
    "test:e2e:install": "node e2e/install-browser.mjs",
    "test:e2e:report": "node e2e/run-playwright.mjs show-report"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
