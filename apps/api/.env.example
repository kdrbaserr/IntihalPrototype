INTIHAL_APP_NAME=Intihal Prototype API
INTIHAL_APP_VERSION=0.1.0
INTIHAL_ENVIRONMENT=local
INTIHAL_DEBUG=false
INTIHAL_API_V1_PREFIX=/api/v1
INTIHAL_DATABASE_URL=postgresql+asyncpg://intihal_app:local-postgres-change-me@localhost:5432/intihal
INTIHAL_ALGORITHM_VERSION=classical-hybrid-v1
INTIHAL_SIMILARITY_THRESHOLD=0.8000
INTIHAL_WORD_TFIDF_WEIGHT=0.50
INTIHAL_CHARACTER_TFIDF_WEIGHT=0.30
INTIHAL_WORD_OVERLAP_WEIGHT=0.20
