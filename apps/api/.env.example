INTIHAL_APP_NAME=Intihal Prototype API
INTIHAL_APP_VERSION=0.1.0
INTIHAL_ENVIRONMENT=local
INTIHAL_DEBUG=false
INTIHAL_API_V1_PREFIX=/api/v1
INTIHAL_DATABASE_URL=postgresql+asyncpg://intihal_app:local-postgres-change-me@localhost:5432/intihal
INTIHAL_ALGORITHM_VERSION=classical-hybrid-v1
INTIHAL_SIMILARITY_THRESHOLD=0.8000
INTIHAL_WORD_TFIDF_WEIGHT=0.50
INTIHAL_CHARACTER_TFIDF_WEIGHT=0.30
INTIHAL_WORD_OVERLAP_WEIGHT=0.20
INTIHAL_REDIS_HOST=localhost
INTIHAL_REDIS_PORT=6379
INTIHAL_REDIS_PASSWORD=local-redis-change-me
INTIHAL_REDIS_BROKER_DB=0
INTIHAL_REDIS_RESULT_DB=1
INTIHAL_WORKER_CONCURRENCY=2
INTIHAL_TASK_SOFT_TIMEOUT_SECONDS=240
INTIHAL_TASK_HARD_TIMEOUT_SECONDS=300
INTIHAL_TASK_MAX_RETRIES=3
INTIHAL_TASK_RETRY_BACKOFF_SECONDS=10
INTIHAL_TASK_RETRY_BACKOFF_MAX_SECONDS=120
INTIHAL_REDIS_VISIBILITY_TIMEOUT_SECONDS=900
INTIHAL_TASK_RESULT_EXPIRES_SECONDS=86400
