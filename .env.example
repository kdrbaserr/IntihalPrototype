# Yerel geliştirme şablonu.
# Bu dosyayı repoda tut; gerçek değerlerin bulunduğu .env dosyasını commit etme.
# Aşağıdaki örnek şifreleri production ortamında kesinlikle kullanma.

# Uygulamanın bilgisayarda açılacağı portlar
API_PORT=8000
WEB_PORT=3000

# FastAPI ayarları
INTIHAL_APP_NAME=Intihal Prototype API
INTIHAL_APP_VERSION=0.1.0
INTIHAL_ENVIRONMENT=local
INTIHAL_DEBUG=true
INTIHAL_API_V1_PREFIX=/api/v1
INTIHAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Tarayıcının API'ye ulaşmak için kullanacağı adres
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Gerçek kimlik doğrulama gelene kadar yerel arayüzün kullandığı demo kullanıcı
NEXT_PUBLIC_DEMO_USER_ID=11111111-1111-1111-1111-111111111111

# PostgreSQL
POSTGRES_DB=intihal
POSTGRES_USER=intihal_app
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432

# API'nin kullandığı async PostgreSQL bağlantısı
# Docker dışında API çalıştırılırsa sunucu adı localhost olarak kalmalıdır.
INTIHAL_DATABASE_URL=postgresql+asyncpg://intihal_app:local-postgres-change-me@localhost:5432/intihal

# Redis
REDIS_PASSWORD=local-redis-change-me
REDIS_PORT=6379

# Celery worker; Docker içinde host/port Compose tarafından ayarlanır.
INTIHAL_REDIS_HOST=localhost
INTIHAL_REDIS_PORT=6379
INTIHAL_REDIS_PASSWORD=local-redis-change-me
INTIHAL_REDIS_BROKER_DB=0
INTIHAL_REDIS_RESULT_DB=1
INTIHAL_WORKER_CONCURRENCY=2
INTIHAL_TASK_SOFT_TIMEOUT_SECONDS=240
INTIHAL_TASK_HARD_TIMEOUT_SECONDS=300
INTIHAL_TASK_MAX_RETRIES=3
INTIHAL_ANALYSIS_MANUAL_RETRY_LIMIT=3
INTIHAL_ANALYSIS_MANUAL_RETRY_DELAY_SECONDS=30
INTIHAL_TASK_RETRY_BACKOFF_SECONDS=10
INTIHAL_TASK_RETRY_BACKOFF_MAX_SECONDS=120
INTIHAL_REDIS_VISIBILITY_TIMEOUT_SECONDS=900
INTIHAL_TASK_RESULT_EXPIRES_SECONDS=86400

# MinIO (S3 uyumlu dosya depolama)
MINIO_ROOT_USER=intihal_minio
MINIO_ROOT_PASSWORD=local-minio-change-me-12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API'nin MinIO bağlantısı. Docker dışında endpoint localhost olmalıdır.
INTIHAL_MINIO_ENDPOINT=localhost:9000
INTIHAL_MINIO_ACCESS_KEY=intihal_minio
INTIHAL_MINIO_SECRET_KEY=local-minio-change-me-12345
INTIHAL_MINIO_SECURE=false
INTIHAL_MINIO_BUCKET=intihal-documents
INTIHAL_MINIO_CONNECT_TIMEOUT_SECONDS=2
INTIHAL_MINIO_READ_TIMEOUT_SECONDS=5

# Klasik benzerlik algoritması. Ağırlıkların toplamı tam olarak 1 olmalıdır.
INTIHAL_ALGORITHM_VERSION=classical-hybrid-v1
INTIHAL_SIMILARITY_THRESHOLD=0.8000
INTIHAL_WORD_TFIDF_WEIGHT=0.50
INTIHAL_CHARACTER_TFIDF_WEIGHT=0.30
INTIHAL_WORD_OVERLAP_WEIGHT=0.20
